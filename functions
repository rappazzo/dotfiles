function rm-cogs {
   if [[ ! -d "modules" ]]; then
      if cd $(git rev-parse --show-cdup) 2>/dev/null; then
         echo "This is not a COG-enabled repository -- skipping" >&2
      fi
   fi
   if [[ -d "modules" ]]; then
      rm -rf modules/main/cross-module/src/gen/java
      rm -rf modules/main/cross-module/src/gen/resources
      rm -rf modules/main/cross-module/build/classes/java/gen
   fi
}
function fetch {
   if git rev-parse --is-inside-work-tree &>/dev/null; then
      GIT_ROOT=$(git rev-parse --show-toplevel)
      if [ -f "$GIT_ROOT/.MODULE_ROOT" ]; then
         git-fetch-daily --all
      else
         git fetch-daily
      fi
   else
      echo "Not in a git worktree" >&2
   fi
}
function git-activity() {
   local months=${2:-12}
   git log --author="$1" --format="%ad" --date=format:"%Y-%m" --since="$months months ago" | \
      sort | uniq -c | \
      awk '{printf "%s: ", $2; for(i=0;i<$1;i++) printf "█"; printf " (%d)\n", $1}'
}
